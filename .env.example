# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Alpaca (stocks — paper trading) ──────────────────────────────────────────
# Get free keys at: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# ── OANDA (forex — demo account) ─────────────────────────────────────────────
# 1. Create a free demo account at: https://www.oanda.com/register/#demo
# 2. Log in → My Account → Manage API Access → Generate token
# 3. Account ID is shown on the dashboard (format: 101-001-0000000-001)
OANDA_API_TOKEN=your_oanda_token_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
