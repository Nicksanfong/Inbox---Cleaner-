# Copy this file to .env and fill in your values
# Never commit .env to git

# Alpaca API credentials (paper trading — safe, uses fake money)
# Get your free keys at: https://app.alpaca.markets  → Paper Trading → API Keys
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Database (optional, leave blank to use CSV files)
DATABASE_URL=

# Logging
LOG_LEVEL=INFO

# Environment: development | staging | production
ENVIRONMENT=development
